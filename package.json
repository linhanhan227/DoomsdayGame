{
  "name": "zombie-survival-text-game",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AI 驱动的末日丧尸生存文字游戏 —— 前端纯静态（无数据库后端），SQLite(WASM) 存档",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode single",
    "build:host": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "start": "node server.js",
    "serve": "node server.js",
    "test:llm": "node scripts/llm-response-test.mjs",
    "build:bonto": "npm run build:host && node scripts/build-bonto.mjs",
    "deploy:bonto": "node scripts/deploy-bonto.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
